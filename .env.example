# Sites yönetim ekranında yalnızca bu e-posta adresine yetki verilir.
# Gerçek adresi yerel .env dosyasına veya yayın ortamı ayarlarına ekleyin.
ADMIN_EMAIL=

# Yalnızca yerel geliştirme sırasında yönetim panelini test etmek için kullanılır.
# Bu değeri production ortamına eklemeyin.
LOCAL_ADMIN_TEST_EMAIL=

# Yayınlandıktan sonra örnek: https://denizunlu.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yerelde Cloudflare'ın resmî test anahtarlarını, yayında gerçek Turnstile
# anahtarlarını kullanın. Gizli anahtarı yalnızca sunucu ortamına ekleyin.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Çekiliş/KVKK talepleri için ziyaretçilere gösterilecek e-posta adresi.
NEXT_PUBLIC_PRIVACY_EMAIL=
